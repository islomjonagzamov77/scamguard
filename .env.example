# Copy to .env and paste the token @BotFather gave you. Never commit .env.
BOT_TOKEN=

# Optional online link checks (free keys). Without them the bot still checks domain age.
# Google Safe Browsing: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_KEY=
# VirusTotal (also checks .apk files by their SHA-256; the file itself is never uploaded): https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=
# Set to 0 to switch off all online checks
SCAMGUARD_ONLINE_CHECKS=1
